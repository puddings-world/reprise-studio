  "lyrics": [
    {
      "t": 42.65,
      "end": 46.81,
      "text": "当 我和世界不一样"
    },
    {
      "t": 46.81,
      "end": 49.84,
      "text": "那就让我不一样"
    },
    {
      "t": 49.84,
      "end": 54.93,
      "text": "坚持对我来说就是以刚克刚"
    },
    {
      "t": 54.93,
      "end": 59.1,
      "text": "我 如果对自己妥协"
    },
    {
      "t": 59.1,
      "end": 62.14,
      "text": "如果对自己说谎"
    },
    {
      "t": 62.14,
      "end": 67.18,
      "text": "即使别人原谅 我也不能原谅"
    },
    {
      "t": 67.18,
      "end": 73.18,
      "text": "最美的愿望 一定最疯狂"
    },
    {
      "t": 73.33,
      "end": 76.4,
      "text": "我就是我自己的神"
    },
    {
      "t": 76.4,
      "end": 79.43,
      "text": "在我活的地方"
    },
    {
      "t": 79.43,
      "end": 82.63,
      "text": "我和我最后的倔强"
    },
    {
      "t": 82.63,
      "end": 85.67,
      "text": "握紧双手绝对不放"
    },
    {
      "t": 85.67,
      "end": 88.5,
      "text": "下一站是不是天堂"
    },
    {
      "t": 88.5,
      "end": 4.06,
      "text": "就算失望不能绝望"
    },
    {
      "t": 91.82,
      "end": 94.92,
      "text": "我和我骄傲的倔强"
    },
    {
      "t": 94.92,
      "end": 97.98,
      "text": "我在风中大声地唱"
    },
    {
      "t": 97.98,
      "end": 100.91,
      "text": "这一次为自己疯狂"
    },
    {
      "t": 100.91,
      "end": 106.91,
      "text": "就这一次 我和我的倔强"
    },
    {
      "t": 119.48,
      "end": 123.66,
      "text": "对 爱我的人别紧张"
    },
    {
      "t": 123.66,
      "end": 126.74,
      "text": "我的固执很善良"
    },
    {
      "t": 126.74,
      "end": 128.72,
      "text": "我的手越肮脏"
    },
    {
      "t": 128.72,
      "end": 131.78,
      "text": "眼神越是发光"
    },
    {
      "t": 131.78,
      "end": 136.01,
      "text": "你 不在乎我的过往"
    },
    {
      "t": 136.01,
      "end": 139.07,
      "text": "看到了我的翅膀"
    },
    {
      "t": 139.07,
      "end": 141.08,
      "text": "你说被火烧过"
    },
    {
      "t": 141.08,
      "end": 144.11,
      "text": "才能出现凤凰"
    },
    {
      "t": 144.11,
      "end": 150.11,
      "text": "逆风的方向 更适合飞翔"
    },
    {
      "t": 150.31,
      "end": 153.4,
      "text": "我不怕千万人阻挡"
    },
