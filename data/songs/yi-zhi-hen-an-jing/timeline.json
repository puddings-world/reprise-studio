  "lyrics": [
    {
      "t": 25.19,
      "end": 29.23,
      "text": "空荡的街景"
    },
    {
      "t": 29.23,
      "end": 35.02,
      "text": "想找个人放感情"
    },
    {
      "t": 35.02,
      "end": 38.68,
      "text": "做这种决定"
    },
    {
      "t": 38.68,
      "end": 44.2,
      "text": "是寂寞与我为邻"
    },
    {
      "t": 44.2,
      "end": 48.24,
      "text": "我们的爱情"
    },
    {
      "t": 48.24,
      "end": 53.7,
      "text": "像你路过的风景"
    },
    {
      "t": 53.7,
      "end": 57.26,
      "text": "一直在进行"
    },
    {
      "t": 57.26,
      "end": 63.26,
      "text": "脚步却从来不会为我而停"
    },
    {
      "t": 64.75,
      "end": 69.25,
      "text": "给你的爱一直很安静"
    },
    {
      "t": 69.25,
      "end": 74.26,
      "text": "来交换你偶尔给的关心"
    },
    {
