  "lyrics": [
    {
      "t": 26.95,
      "end": 32.95,
      "text": "日出又日落 深处再深处"
    },
    {
      "t": 33.89,
      "end": 39.89,
      "text": "一张小方桌 有一荤一素"
    },
    {
      "t": 40.6,
      "end": 46.6,
      "text": "一个身影从容地忙忙碌碌"
    },
    {
      "t": 47.25,
      "end": 53.25,
      "text": "一双手让这时光有了温度"
    },
    {
      "t": 54.46,
      "end": 60.46,
      "text": "太年轻的人 他总是不满足"
    },
    {
      "t": 61.37,
      "end": 67.37,
      "text": "固执地不愿停下 远行的脚步"
    },
    {
      "t": 67.8,
      "end": 73.8,
      "text": "望着高高的天走了长长的路"
    },
    {
      "t": 75.19,
      "end": 81.19,
      "text": "忘了回头看 她有没有哭"
    },
    {
      "t": 85.87,
      "end": 91.23,
      "text": "月儿明 风儿轻"
    },
    {
      "t": 91.23,
      "end": 97.23,
      "text": "可是你在敲打我的窗棂"
    },
    {
      "t": 98.19,
      "end": 104.19,
      "text": "听到这儿你就别担心"
    },
    {
      "t": 104.87,
      "end": 110.87,
      "text": "其实我过的还可以"
    },
    {
      "t": 111.48,
      "end": 117.16,
      "text": "月儿明 风儿轻"
    },
    {
      "t": 117.16,
      "end": 123.16,
      "text": "你又可曾来过我的梦里"
    },
    {
      "t": 124.44,
      "end": 130.15,
      "text": "一定是你来时太小心"
    },
    {
      "t": 130.15,
      "end": 136.15,
      "text": "知道我睡得轻"
    },
